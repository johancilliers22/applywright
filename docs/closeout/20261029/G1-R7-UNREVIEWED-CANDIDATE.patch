+
+test("G1: groundChanges refuses every fabricated orchestrator change", () => {
+  const cases = [
+    ["employer opener", "Built services.", "Initech is my employer.", /Initech/],
+    ["hyphen employer", "Worked on services.", "Worked at Initech-labs.", /Initech-labs/],
+    [
+      "unsupported technology",
+      "Reduced deploy time by 40% by rebuilding the pipeline.",
+      "Cut deploy time by 40% with Go-based services.",
+      /"Go"/,
+    ],
+    ["ownership adverb", "Helped with managing 12 engineers.", "Effectively led 12 engineers.", /stronger level of ownership/],
+    [
+      "ownership multiline",
+      "Experience\nHelped with managing 12 engineers across two squads.",
+      "Led a team of 12 engineers across two squads.",
+      /stronger level of ownership/,
+    ],
+    ["degree subject", "Holds a degree in computing.", "Holds a degree in medicine.", /qualification subject "medicine"/],
+    [
+      "seniority",
+      "Worked as a software engineer.",
+      "Worked as a principal software engineer.",
+      /title modifier "principal"/,
+    ],
+    ["date May", "Worked through spring.", "Worked through May.", /month May/],
+    ["spelled one", "Built services.", "Built one service.", /figure one/],
+    ["currency identity", "Saved £40,000 a year.", "Saved $40,000 a year.", /currency amount \$40,000/],
+  ];
+
+  for (const [name, before, after, expected] of cases) {
+    const check = groundChanges(before, after);
+    assert.equal(check.ok, false, `${name}: groundChanges accepted the change`);
+    assert.ok(
+      check.reasons.some((reason) => expected.test(reason)),
+      `${name}: ${JSON.stringify(check.reasons)} did not match ${expected}`
+    );
+    // The same claim is refused by the shared predicate the model path uses.
+    const shared = assertGrounded(before, after);
+    assert.equal(shared.ok, false, `${name}: assertGrounded accepted the change`);
+  }
+});
