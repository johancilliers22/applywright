# Applywright runtime configuration.
#
# Copy to `.env.local` and fill in only what you need; that file is gitignored.
# With nothing set the product still runs: tailoring falls back to deterministic
# rules, plans are visible, and checkout is disabled until Stripe is configured.

# --- server ---------------------------------------------------------------
PORT=3160
HOST=127.0.0.1
DATABASE_PATH=./data/applywright.db
# 1 only behind your own TLS proxy (Caddy/nginx/Cloudflare): makes cookies Secure
# and makes X-Forwarded-For trustworthy.
TRUST_PROXY=0
SECURE_COOKIES=0

# --- tailoring model (OpenAI-compatible) ----------------------------------
# Leave MODEL_API_KEY empty to stay on the deterministic rule-based rewriter.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_MS=60000
MODEL_MAX_TOKENS=2000

# --- billing (optional) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# --- limits ---------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=8388608
MAX_CV_BYTES=5242880
JOB_FEED_LIMIT=60
JOB_FEED_CACHE_MINUTES=15

# --- site -----------------------------------------------------------------
CONTACT_EMAIL=hello@applywright.example
